# GhostWing / Ghostly Environment Template
# Copy this file to .env or .env.local and populate with your Firebase credentials

# Firebase Web Configuration
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY_HERE
VITE_FIREBASE_AUTH_DOMAIN=ghostly-957aa.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ghostly-957aa
VITE_FIREBASE_STORAGE_BUCKET=ghostly-957aa.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID_HERE
VITE_FIREBASE_APP_ID=YOUR_WEB_APP_ID_HERE

# App Check Debug Token (For Hackathon Judges and Local Testing)
VITE_APPCHECK_DEBUG_TOKEN=YOUR_APPCHECK_DEBUG_TOKEN_HERE

# AI Hybrid Inference Configuration
VITE_ESCALATION_CONFIDENCE_THRESHOLD=0.80
VITE_FORCE_STRICT_LOCAL=false
